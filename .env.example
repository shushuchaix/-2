# ============================================================
#  简历岗位雷达 · 环境变量样例
#  复制为 .env 后填写：cp .env.example .env
#  .env 已在 .dockerignore 中排除，不会被构建进镜像
# ============================================================

# ---------- 必填 ----------

# 站点访问密码。监听非 127.0.0.1 时若不设置，服务会拒绝启动（fail-closed）
AUTH_PASSWORD=请换成一个足够强的密码

# DeepSeek API Key。留空则只能使用离线规则模式（匹配质量明显下降）
DEEPSEEK_API_KEY=sk-你的密钥

# ---------- 可选：全网搜索通道 ----------
# 配置任意一个即可把检索范围从「智联+实习僧」扩展到全网招聘页面
TAVILY_API_KEY=
BOCHA_API_KEY=
SERPER_API_KEY=

# ---------- 可选：会话与网络 ----------

# 会话签名密钥。不填会自动生成并持久化到 data/.session-secret
# 多实例部署时必须显式设置成同一个值
# AUTH_SECRET=

HOST=0.0.0.0
PORT=3210

# 部署在 nginx / Caddy 之后时置为 1
TRUST_PROXY=1

# 对外访问地址，用于同源校验与日志展示，例如 https://jobs.example.com
PUBLIC_URL=

# ---------- 可选：限额（防额度被刷爆）----------

# 全站每日检索总次数
DAILY_LIMIT=100
# 单个 IP 每日次数
IP_DAILY_LIMIT=10
# 同时执行的任务数
MAX_CONCURRENT=2
# 排队上限，超过则直接返回 503
MAX_QUEUE=8
# 同一 IP 两次检索之间的最小间隔（毫秒），防连点
PER_IP_COOLDOWN_MS=30000

# ---------- 可选：高级 ----------

# 关闭鉴权（极度危险：任何人都能消耗你的额度并用你的 IP 抓取招聘站）
# 必须同时设置下面这个变量才会放行，防止误配置
# AUTH_MODE=none
# ALLOW_PUBLIC_NO_AUTH=1
